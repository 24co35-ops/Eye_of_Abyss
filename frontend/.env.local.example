# frontend/.env.local.example
#
# Copy to frontend/.env.local for local development (non-Docker).
# Next.js loads .env.local automatically and it is gitignored.
#
# When running services locally (make dev-*), they listen on localhost:800x.
# When running in Docker, the browser calls http://localhost/api/* (nginx :80).
# This file is for the LOCAL case only.

NEXT_PUBLIC_CASE_ENGINE_URL=http://localhost:8000
NEXT_PUBLIC_VOICEGUARD_URL=http://localhost:8001
NEXT_PUBLIC_SHADOWTRACE_URL=http://localhost:8002
NEXT_PUBLIC_CHAINEYE_URL=http://localhost:8003
