# ══════════════════════════════════════════════════════════════════════════════
# Eye of Abyss — Secure Environment Configuration Template
# 
# SECURITY NOTICE:
# - Do NOT use default or placeholder passwords in production.
# - Secrets are validated at service startup (minimum entropy & length enforced).
# - Generate cryptographically secure tokens using:
#     openssl rand -hex 32
# ══════════════════════════════════════════════════════════════════════════════

# ── Environment & Network ────────────────────────────────────────────────────
# Set to 'production' for hardened production mode; 'dev' for local testing
ENVIRONMENT=production

# Comma-separated list of allowed CORS browser origins (required in production; wildcards prohibited)
CORS_ORIGINS=https://eob.yourdomain.com,https://localhost:3000

# Reverse Proxy / TLS
TRUST_PROXY=true
COOKIE_SECURE=true

# ── Authentication & Access Control ──────────────────────────────────────────
# JWT secrets: MUST be at least 32 characters long with high entropy.
# Generate with: openssl rand -hex 32
JWT_SECRET=<GENERATE_WITH_OPENSSL_RAND_HEX_32>
JWT_REFRESH_SECRET=<GENERATE_WITH_OPENSSL_RAND_HEX_32>
JWT_ALGORITHM=HS256

# User registration control
# In production, /auth/register requires this token in the 'invite_token' request field.
INVITE_TOKEN=<GENERATE_INVITE_TOKEN_32_CHARS>

# Disable public wallet auto-registration in production (defaults to false in prod)
ALLOW_WALLET_AUTOREGISTER=false

# Demo/Initial System Owner Account (Seeded on startup)
SEED_OWNER_EMAIL=owner@yourdomain.com
SEED_OWNER_PASSWORD=<GENERATE_STRONG_OWNER_PASSWORD_MIN_16_CHARS>

# ── Databases & Persistence ──────────────────────────────────────────────────
# PostgreSQL
POSTGRES_USER=eyeofabyss
POSTGRES_PASSWORD=<GENERATE_STRONG_POSTGRES_PASSWORD_MIN_16_CHARS>
POSTGRES_DB=eyeofabyss
DATABASE_URL=postgresql://eyeofabyss:<POSTGRES_PASSWORD>@postgres:5432/eyeofabyss

# Neo4j Graph Database
NEO4J_URI=bolt://neo4j:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=<GENERATE_STRONG_NEO4J_PASSWORD_MIN_16_CHARS>

# Redis (Caching, Rate Limiting, Revocation Store)
REDIS_PASSWORD=<GENERATE_STRONG_REDIS_PASSWORD_MIN_16_CHARS>
REDIS_URL=redis://:<REDIS_PASSWORD>@redis:6379/0

# Object Storage (MinIO / AWS S3)
MINIO_ENDPOINT=http://minio:9000
MINIO_ROOT_USER=<SECURE_MINIO_ADMIN_USERNAME>
MINIO_ROOT_PASSWORD=<GENERATE_STRONG_MINIO_PASSWORD_MIN_16_CHARS>
MINIO_REGION=us-east-1

# ── Webhook & Network Defense (SSRF Protection) ──────────────────────────────
# Comma-separated domains allowed for outbound webhook subscriptions (empty allows any public FQDN)
ALLOWED_WEBHOOK_DOMAINS=yourdomain.com,hooks.slack.com

# Request body size limit in MB (hard limit enforced by RequestBodyLimitMiddleware)
MAX_BODY_SIZE_MB=50

# Antivirus Scanning Hook (optional ClamAV daemon)
# CLAMAV_HOST=clamav
# CLAMAV_PORT=3310

# ── Blockchain & IPFS Anchoring ──────────────────────────────────────────────
BLOCKCHAIN_NETWORK=polygon
POLYGON_RPC_URL=https://polygon-mainnet.g.alchemy.com/v2/YOUR_ALCHEMY_KEY
PRIVATE_KEY=<SECURE_DEPLOYER_OR_RELAYER_PRIVATE_KEY>
EVIDENCE_REGISTRY_ADDRESS=<DEPLOYED_CONTRACT_ADDRESS>

# Blockchain Data Explorer APIs (optional)
ETHERSCAN_API_KEY=
ALCHEMY_API_KEY=
BLOCKSTREAM_API_KEY=
BLOCKSTREAM_API_URL=https://blockstream.info/api

# IPFS Pinning (Pinata)
PINATA_API_KEY=
PINATA_SECRET_KEY=

# ── External AI APIs (Optional) ──────────────────────────────────────────────
ANTHROPIC_API_KEY=
